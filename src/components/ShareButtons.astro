---
interface Props {
  title: string;
  url: string;
  coverImage?: string;
  categoryLabel?: string;
}

const {
  title,
  url,
  coverImage = '',
  categoryLabel = '',
} = Astro.props;

const shareUrl = url || Astro.url.href;
const shareCover = coverImage.trim() || '/og-image.png';
const whatsappHref = `https://api.whatsapp.com/send?text=${encodeURIComponent(`${title} ${shareUrl}`)}`;

const titleSlug = title
  .normalize('NFD')
  .replace(/[\u0300-\u036f]/g, '')
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/(^-|-$)/g, '')
  .slice(0, 60);

let pathSlug = '';
try {
  pathSlug = new URL(shareUrl).pathname.replace(/\/+$/, '').split('/').filter(Boolean).pop() || '';
} catch {
  pathSlug = '';
}

const storySlug = (pathSlug || titleSlug || 'conteudo')
  .normalize('NFD')
  .replace(/[\u0300-\u036f]/g, '')
  .toLowerCase()
  .replace(/[^a-z0-9-]+/g, '-')
  .replace(/(^-|-$)/g, '');

const storyFilename = `story-${storySlug || 'conteudo'}.jpg`;
---

<div
  class="p-4 my-8 rounded-xl border border-zinc-800 bg-zinc-900/70 flex flex-wrap items-center justify-between gap-4"
  data-share-root
  data-title={title}
  data-url={shareUrl}
  data-cover={shareCover}
  data-category={categoryLabel}
  data-filename={storyFilename}
>
  <div class="min-w-0">
    {categoryLabel && (
      <p class="text-[10px] font-semibold uppercase tracking-[0.22em] text-emerald-400 mb-1">
        {categoryLabel}
      </p>
    )}
    <p class="text-sm text-zinc-400">
      Gostou do conteúdo? <span class="font-medium text-zinc-100">Compartilhe:</span>
    </p>
  </div>

  <div class="flex flex-wrap items-center gap-2">
    <a
      href={whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-3 py-2 text-xs font-semibold text-emerald-300 transition-colors hover:border-emerald-400/60 hover:bg-emerald-500/20"
      aria-label="Compartilhar no WhatsApp"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347Zm-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.82 9.82 0 0 1 6.988 2.898 9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884Zm8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
      </svg>
      <span>WhatsApp</span>
    </a>

    <button
      type="button"
      data-share-native
      class="inline-flex items-center gap-2 rounded-lg border border-zinc-700 bg-zinc-800/80 px-3 py-2 text-xs font-semibold text-zinc-200 transition-colors hover:border-zinc-600 hover:bg-zinc-700/80"
      aria-label="Compartilhar usando o navegador"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
        <path d="m8.59 13.51 6.83 3.98M15.41 6.51 8.59 10.49"/>
      </svg>
      <span data-share-native-label>Compartilhar</span>
    </button>

    <button
      type="button"
      data-share-copy
      class="inline-flex items-center gap-2 rounded-lg border border-zinc-700 bg-zinc-800/80 px-3 py-2 text-xs font-semibold text-zinc-200 transition-colors hover:border-zinc-600 hover:bg-zinc-700/80"
      aria-label="Copiar link do conteúdo"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
      </svg>
      <span data-share-copy-label>Copiar link</span>
    </button>

    <button
      type="button"
      data-share-story
      class="inline-flex items-center gap-2 rounded-lg bg-amber-400 px-3 py-2 text-xs font-bold text-zinc-950 shadow-sm shadow-amber-400/20 transition-all hover:bg-amber-300 active:scale-95"
      aria-label="Baixar imagem vertical para Story"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3v12"/>
        <path d="m7 10 5 5 5-5"/>
        <path d="M5 21h14"/>
      </svg>
      <span data-share-story-label>Baixar p/ Story</span>
    </button>
  </div>
</div>

<script>
  const FONT_SANS = 'Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", Arial, sans-serif';
  const FONT_MONO = '"Courier New", ui-monospace, SFMono-Regular, Menlo, monospace';
  const CANVAS_WIDTH = 1080;
  const CANVAS_HEIGHT = 1920;
  const IMAGE_HEIGHT = 980;
  const BACKGROUND = '#121214';
  const AMBER = '#FBB03B';
  const EMERALD = '#34D399';
  const DEFAULT_TAG = 'MÉTODO SIM | O MARCENEIRO DIGITAL';

  function legacyCopy(text) {
    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.setAttribute('readonly', '');
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    textarea.style.pointerEvents = 'none';
    document.body.appendChild(textarea);
    textarea.select();
    textarea.setSelectionRange(0, textarea.value.length);

    let success = false;
    try {
      success = document.execCommand('copy');
    } catch {
      success = false;
    }

    textarea.remove();
    return success;
  }

  async function copyToClipboard(text) {
    if (navigator.clipboard && window.isSecureContext) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        return legacyCopy(text);
      }
    }
    return legacyCopy(text);
  }

  function showFeedback(element, message, duration = 2200) {
    if (!element) return;
    const original = element.dataset.originalLabel || element.textContent || '';
    element.dataset.originalLabel = original;
    element.textContent = message;

    window.clearTimeout(Number(element.dataset.feedbackTimer || 0));
    const timer = window.setTimeout(() => {
      element.textContent = original;
      delete element.dataset.feedbackTimer;
    }, duration);
    element.dataset.feedbackTimer = String(timer);
  }

  function loadImage(src) {
    return new Promise((resolve, reject) => {
      if (!src) {
        reject(new Error('Imagem de capa ausente.'));
        return;
      }

      const image = new Image();
      image.crossOrigin = 'anonymous';
      image.decoding = 'async';
      image.onload = () => resolve(image);
      image.onerror = () => reject(new Error('Não foi possível carregar a imagem de capa.'));
      image.src = new URL(src, window.location.href).href;
    });
  }

  function drawFallbackCover(context) {
    const gradient = context.createLinearGradient(0, 0, CANVAS_WIDTH, IMAGE_HEIGHT);
    gradient.addColorStop(0, '#1B1B20');
    gradient.addColorStop(0.55, '#0F2F26');
    gradient.addColorStop(1, BACKGROUND);

    context.fillStyle = gradient;
    context.fillRect(0, 0, CANVAS_WIDTH, IMAGE_HEIGHT);

    context.strokeStyle = 'rgba(52, 211, 153, 0.10)';
    context.lineWidth = 1;
    for (let x = 0; x <= CANVAS_WIDTH; x += 90) {
      context.beginPath();
      context.moveTo(x, 0);
      context.lineTo(x, IMAGE_HEIGHT);
      context.stroke();
    }
    for (let y = 0; y <= IMAGE_HEIGHT; y += 90) {
      context.beginPath();
      context.moveTo(0, y);
      context.lineTo(CANVAS_WIDTH, y);
      context.stroke();
    }

    context.fillStyle = 'rgba(251, 176, 59, 0.14)';
    context.fillRect(80, 310, 10, 250);

    context.fillStyle = 'rgba(255, 255, 255, 0.94)';
    context.font = `800 62px ${FONT_SANS}`;
    context.fillText('O MARCENEIRO', 120, 400);
    context.fillText('DIGITAL', 120, 474);

    context.fillStyle = AMBER;
    context.font = `700 26px ${FONT_MONO}`;
    context.fillText('MÉTODO SIM', 120, 536);
  }

  function drawCoverImage(context, image) {
    const scale = Math.max(CANVAS_WIDTH / image.width, IMAGE_HEIGHT / image.height);
    const width = image.width * scale;
    const height = image.height * scale;
    const offsetX = (CANVAS_WIDTH - width) / 2;
    const offsetY = (IMAGE_HEIGHT - height) / 2;

    context.drawImage(image, offsetX, offsetY, width, height);
  }

  function wrapTitle(context, text, maxWidth, maxLines) {
    const words = String(text).replace(/\s+/g, ' ').trim().split(' ');
    const lines = [];
    let line = '';
    let truncated = false;

    for (const word of words) {
      const candidate = line ? `${line} ${word}` : word;

      if (context.measureText(candidate).width <= maxWidth) {
        line = candidate;
        continue;
      }

      if (line) {
        lines.push(line);
        line = word;
      } else {
        lines.push(word);
        line = '';
      }

      if (lines.length === maxLines) {
        truncated = true;
        break;
      }
    }

    if (!truncated && line) {
      lines.push(line);
    }

    if (truncated && lines.length) {
      let last = lines[Math.min(lines.length, maxLines) - 1];
      while (last.length > 0 && context.measureText(`${last}…`).width > maxWidth) {
        last = last.slice(0, -1).trimEnd();
      }
      lines[Math.min(lines.length, maxLines) - 1] = `${last}…`;
    }

    return lines.slice(0, maxLines);
  }

  function drawOverlay(context) {
    const gradient = context.createLinearGradient(0, 700, 0, IMAGE_HEIGHT);
    gradient.addColorStop(0, 'rgba(18, 18, 20, 0)');
    gradient.addColorStop(1, BACKGROUND);
    context.fillStyle = gradient;
    context.fillRect(0, 700, CANVAS_WIDTH, IMAGE_HEIGHT - 700);
  }

  function drawStoryCard(context, options) {
    const cardTitle = options.title || 'Conteúdo O Marceneiro Digital';
    const category = (options.category || DEFAULT_TAG).toUpperCase();

    drawOverlay(context);

    context.fillStyle = AMBER;
    context.fillRect(80, 1030, 56, 4);

    context.fillStyle = EMERALD;
    context.font = `700 26px ${FONT_MONO}`;
    context.fillText(category, 80, 1082);

    context.fillStyle = '#FFFFFF';
    context.font = `800 54px ${FONT_SANS}`;
    const titleLines = wrapTitle(context, cardTitle, 920, 3);
    const lineHeight = 68;
    const firstBaseline = 1172;

    titleLines.forEach((line, index) => {
      context.fillText(line, 80, firstBaseline + index * lineHeight);
    });

    context.fillStyle = 'rgba(255, 255, 255, 0.12)';
    context.fillRect(80, 1716, 920, 2);

    context.fillStyle = 'rgba(255, 255, 255, 0.72)';
    context.font = `500 30px ${FONT_SANS}`;
    context.fillText('Toque na figurinha para ler completo', 80, 1778);

    context.fillStyle = AMBER;
    context.font = `700 28px ${FONT_SANS}`;
    context.fillText('omarceneirodigital.com.br', 80, 1836);
  }

  async function downloadStory(root) {
    const canvas = document.createElement('canvas');
    canvas.width = CANVAS_WIDTH;
    canvas.height = CANVAS_HEIGHT;

    const context = canvas.getContext('2d');
    if (!context) {
      throw new Error('Canvas não suportado neste navegador.');
    }

    context.fillStyle = BACKGROUND;
    context.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);

    try {
      const image = await loadImage(root.dataset.cover || '');
      drawCoverImage(context, image);
    } catch {
      drawFallbackCover(context);
    }

    drawStoryCard(context, {
      title: root.dataset.title || '',
      category: root.dataset.category || DEFAULT_TAG,
    });

    const dataUrl = canvas.toDataURL('image/jpeg', 0.85);
    const link = document.createElement('a');
    link.href = dataUrl;
    link.download = root.dataset.filename || 'story-conteudo.jpg';
    link.rel = 'noopener';
    document.body.appendChild(link);
    link.click();
    link.remove();
  }

  function initShareRoot(root) {
    if (root.dataset.shareReady === 'true') return;
    root.dataset.shareReady = 'true';

    const shareUrl = root.dataset.url || window.location.href;
    const title = root.dataset.title || document.title;

    const nativeButton = root.querySelector('[data-share-native]');
    const nativeLabel = root.querySelector('[data-share-native-label]');
    const copyButton = root.querySelector('[data-share-copy]');
    const copyLabel = root.querySelector('[data-share-copy-label]');
    const storyButton = root.querySelector('[data-share-story]');
    const storyLabel = root.querySelector('[data-share-story-label]');

    const fallbackToCopy = async () => {
      const copied = await copyToClipboard(shareUrl);
      showFeedback(nativeLabel, copied ? 'Link copiado!' : 'Copie o link');
    };

    nativeButton?.addEventListener('click', async () => {
      const shareData = {
        title,
        text: title,
        url: shareUrl,
      };

      if (typeof navigator.share === 'function') {
        try {
          await navigator.share(shareData);
          showFeedback(nativeLabel, 'Compartilhado!');
        } catch (error) {
          if (error && error.name === 'AbortError') return;
          await fallbackToCopy();
        }
        return;
      }

      await fallbackToCopy();
    });

    copyButton?.addEventListener('click', async () => {
      const copied = await copyToClipboard(shareUrl);
      showFeedback(copyLabel, copied ? 'Link copiado!' : 'Não foi possível copiar');
    });

    storyButton?.addEventListener('click', async () => {
      if (storyButton.disabled) return;

      storyButton.disabled = true;
      storyButton.setAttribute('aria-busy', 'true');
      showFeedback(storyLabel, 'Gerando...', 15000);

      try {
        await downloadStory(root);
        showFeedback(storyLabel, 'Story baixado!');
      } catch {
        showFeedback(storyLabel, 'Erro ao gerar');
      } finally {
        storyButton.disabled = false;
        storyButton.removeAttribute('aria-busy');
      }
    });
  }

  document.querySelectorAll('[data-share-root]').forEach(initShareRoot);
</script>
